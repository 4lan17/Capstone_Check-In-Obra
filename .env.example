# Contraseñas de la base. Todas OBLIGATORIAS y sin valor por defecto; generar cada
# una con:  openssl rand -base64 36 | tr -d '+/=\n'
# scripts/levantar.sh las genera solas la primera vez.
#   POSTGRES_PASSWORD    superusuario "postgres": solo administración, la API no lo usa
#   DB_APP_PASSWORD      checkinobra_app: usuario de la API, solo DML
#   DB_MIGRADOR_PASSWORD checkinobra_migrador: dueño del esquema, solo lo usa Flyway
POSTGRES_PASSWORD=CAMBIAR_generar_con_openssl_rand_base64_36
DB_APP_PASSWORD=CAMBIAR_generar_con_openssl_rand_base64_36
DB_MIGRADOR_PASSWORD=CAMBIAR_generar_con_openssl_rand_base64_36

# Firma de los JWT. OBLIGATORIO: la API no arranca si falta, tiene menos de 32
# bytes o es este marcador. Generar uno propio:  openssl rand -base64 48
# (scripts/levantar.sh lo genera solo la primera vez). Si una instancia ya corrió
# con el valor por defecto antiguo, cambiarlo: los tokens firmados con él valían.
JWT_SECRET=CAMBIAR_generar_con_openssl_rand_base64_48
