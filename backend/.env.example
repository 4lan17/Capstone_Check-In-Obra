# Puerto 5433: es el que docker-compose publica en el host para PostgreSQL.
# Este archivo solo aplica si corres el backend FUERA de Docker (desde el IDE).
# Dentro de docker-compose la URL la inyecta el propio compose como db:5432.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/checkinobra
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
JWT_SECRET=cambiar-por-un-valor-largo-y-aleatorio
BREVO_SMTP_USER=
BREVO_SMTP_PASSWORD=
