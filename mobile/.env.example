# 10.0.2.2 es como el EMULADOR de Android accede al localhost del computador.
# El puerto 8081 es el que publica docker-compose para el backend.
# En un CELULAR FÍSICO por USB, reemplazar por la IP local del computador
# en la red WiFi, por ejemplo: http://192.168.1.50:8081
API_BASE_URL=http://10.0.2.2:8081
